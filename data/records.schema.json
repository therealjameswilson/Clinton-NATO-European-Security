{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRUS Volume XVII NATO and European Security Compiler Record",
  "type": "object",
  "required": [
    "id",
    "date",
    "type",
    "title",
    "participants",
    "countries",
    "chapter",
    "releaseStatus",
    "naid",
    "catalogUrl",
    "frusVolume",
    "frusTopics",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "sortDate": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": ["Memcon", "Telcon", "Release Packet", "Context", "Scout Lead", "Source Lead"]
    },
    "documentNumber": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "documentTitle": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chapter": {
      "type": "object",
      "required": ["number", "name"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "name": {
          "type": "string",
          "enum": [
            "NATO Strategy and Enlargement",
            "NATO-Russia and Partnership",
            "European Security Architecture",
            "Crisis Security Files"
          ]
        }
      }
    },
    "releaseStatus": {
      "type": "string",
      "enum": [
        "Full",
        "Partial",
        "Mixed",
        "Unknown",
        "FOIA/MDR Lead",
        "Catalog Lead",
        "Search Lead",
        "Withheld in Full"
      ]
    },
    "selectionDecision": {
      "type": "string",
      "enum": ["Pending", "Include candidate", "Context candidate", "Exclude", "Ready for editor"]
    },
    "compilerDecision": {
      "type": "string"
    },
    "productionIssues": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "needs-selection",
          "needs-source",
          "needs-chronology",
          "needs-declass",
          "needs-annotation",
          "needs-index"
        ]
      }
    },
    "naid": {
      "type": "string"
    },
    "catalogUrl": {
      "type": "string",
      "format": "uri-reference"
    },
    "pdfUrl": {
      "type": "string",
      "format": "uri-reference"
    },
    "pageCount": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "digitalObjects": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "dateLine": {
      "type": "string"
    },
    "washingtonTime": {
      "type": "string"
    },
    "placementNote": {
      "type": "string"
    },
    "subjectLine": {
      "type": "string"
    },
    "sourceNote": {
      "type": "string"
    },
    "sourceNoteStatus": {
      "type": "string",
      "enum": ["Pending", "Draft", "Complete", "Needs verification"]
    },
    "sourceNoteAddendum": {
      "type": "string"
    },
    "sourcePages": {
      "type": "string"
    },
    "originalClassification": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "documentMarkings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handlingMarkings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "telegramPrecedence": {
      "type": "string"
    },
    "distribution": {
      "type": "string"
    },
    "draftingInfo": {
      "type": "string"
    },
    "clearance": {
      "type": "object",
      "properties": {
        "draftedBy": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "clearedBy": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "approvedBy": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "communication": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string"
        },
        "precedence": {
          "type": "string"
        },
        "sentTo": {
          "type": "string"
        },
        "sentForInfo": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "meetingLocation": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "readBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "declassificationStatus": {
      "type": "string",
      "enum": [
        "Released in full",
        "Released with minor excisions",
        "Excised paragraph or more",
        "Withheld in full",
        "Pending review",
        "Not applicable"
      ]
    },
    "withheldMaterial": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "omittedLines": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "omittedPages": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "annotationStatus": {
      "type": "string",
      "enum": ["Pending", "Drafted", "Ready"]
    },
    "annotation": {
      "type": "object",
      "properties": {
        "firstFootnote": {
          "type": "string"
        },
        "relatedDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publicStatements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "memoirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "extractionStatus": {
      "type": "string"
    },
    "transcriptionUrl": {
      "type": "string",
      "format": "uri-reference"
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri-reference"
        },
        "pdfUrl": {
          "type": "string",
          "format": "uri-reference"
        },
        "caseNumber": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collection": {
          "type": "string"
        },
        "series": {
          "type": "string"
        },
        "subseries": {
          "type": "string"
        },
        "lotFile": {
          "type": "string"
        },
        "fileUnit": {
          "type": "string"
        },
        "box": {
          "type": "string"
        },
        "folder": {
          "type": "string"
        },
        "itemTitle": {
          "type": "string"
        }
      }
    },
    "frusVolume": {
      "type": "object",
      "required": ["id", "title", "url", "status"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "frusTopics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "indexTerms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "persons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compilerNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedReleaseIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
